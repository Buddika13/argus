# Optional environment configuration for Argus.
# Copy to .env and adjust. Only ARGUS_VANTAGE is read by the application.

# Identifies this probe node in stored measurements. Set per vantage point.
ARGUS_VANTAGE=colombo-01

# All other settings (sweep interval, resolvers, watch-list, database path,
# DNSSEC toggle) live in config/config.yaml, config/resolvers.yaml and
# config/watchlist.txt — not here.
